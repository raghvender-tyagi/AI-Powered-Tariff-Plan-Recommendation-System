# ---- server ----
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- database ----
# The API uses MongoDB when it can reach it. If mongod is not running it
# falls back to a durable JSON file store so the whole flow still works.
MONGO_URI=mongodb://127.0.0.1:27017/tariff_twin
MONGO_CONNECT_TIMEOUT_MS=4000
ALLOW_FILE_STORE_FALLBACK=true

# ---- auth (admin dashboard) ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- seeding ----
SEED_CUSTOMER_LIMIT=1000

# ---- optional LLM polish for the advisor ----
# Everything works without this. With a key set, the advisor rephrases the
# retrieved facts and the engine's Top 3; it never ranks or invents plans.
OPENAI_API_KEY=
CHAT_MODEL=openai:gpt-4o-mini
